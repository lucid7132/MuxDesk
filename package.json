{
  "name": "cmux-windows",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent terminal workspaces for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "check:release": "node scripts/check-release.js",
    "dev": "electron .",
    "check:package": "node scripts/check-package.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "local.cmux.windows.v1",
    "productName": "cmux",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "src/terminal-daemon.js"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!**/.env{,/**}",
      "!**/*.log",
      "!**/*.pdb",
      "!node_modules/node-pty/prebuilds/darwin-*/**/*",
      "!node_modules/node-pty/prebuilds/win32-arm64/**/*",
      "!node_modules/node-pty/src/**/*",
      "!node_modules/node-pty/test/**/*",
      "!node_modules/node-pty/deps/**/*",
      "!node_modules/node-pty/third_party/**/*",
      "!node_modules/node-addon-api/**/*",
      "!node_modules/node-pty/lib/**/*.test.js",
      "!node_modules/node-pty/lib/**/*.js.map",
      "!node_modules/node-pty/typings/**/*",
      "!node_modules/node-pty/scripts/**/*",
      "!node_modules/node-pty/build/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "cmux-v${version}.exe"
    },
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "ko"
    ]
  },
  "overrides": {
    "app-builder-lib": {
      "tar": "7.5.22",
      "@electron/get": "5.1.0"
    }
  }
}
